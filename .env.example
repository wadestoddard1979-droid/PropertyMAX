# PropertMax Phase 2 — copy to .env.local (never commit secrets)
#
# Without these three, the app runs in local-json demo mode
# (cookie pilot logins + data/propertmax-store.json). `npm run build` works offline.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional
# PROPERTYMAX_SESSION_SECRET=replace-me-in-production
# ALLOW_DEMO_LOGIN=true
# SEED_TARGET=supabase

# AI maintenance intake (optional LLM refine; rules always run; spend never auto-authorized)
# AI_INTAKE_LLM=true
# OPENAI_API_KEY=
# AI_INTAKE_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Stripe rent payments (Checkout / hosted pay only — never vault cards in-app)
# Without these, Payments UI runs in DEMO MODE: simulates checkout success
# and labels it clearly. Webhook endpoint: POST /api/payments/webhook
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Phase 3: without Stripe keys, SaaS plan changes create DEMO invoices
# (clearly labeled, not real charges). See docs/PHASE3-COMMERCIAL.md.
